        },
        "current": false
      },
      {
        "id": "m1",
        "label": "M1 · Basic-rule imitation",
        "family": "solver-imitation",
        "desc": "Behaviour cloning of the deterministic solver using only the basic number rules (rem==0 / rem==len), no subset reasoning. Small width-32 net on a short schedule; the cheap weak-target floor that still guesses on hard frontiers.",
        "rows": {
          "Family": "solver-imitation",
          "Method": "Behaviour cloning (basic solver)",
          "Architecture": "width 32 · 4 layers · 16,225 params",
          "Training": "2,000 games · 16 epochs · lr 0.002 · target basic-solver",
          "File size": "64.9 KB",
          "Eval": "win 28.8% · mine-hit 71.2% · stuck 0.0% · avg safe 37.9"
        },
        "current": false
      },
      {
        "id": "m2",
        "label": "M2 · Subset-solver imitation",
        "family": "solver-imitation",
        "desc": "Same cloning recipe as M1 but the demonstrations come from the solver with 1-level subset inference, so the target is stronger. Width raised to 48 to absorb the harder target; the workhorse mid-tier model and the warm-start for the two RL variants.",
        "rows": {
          "Family": "solver-imitation",
          "Method": "Behaviour cloning (subset solver)",
          "Architecture": "width 48 · 4 layers · 31,233 params",
          "Training": "3,000 games · 16 epochs · lr 0.002 · target subset-solver",
          "File size": "123.5 KB",
          "Eval": "win 56.4% · mine-hit 43.6% · stuck 0.0% · avg safe 46.8"
        },
        "current": false
      },
      {
        "id": "m3",
        "label": "M3 · Wide + deep imitation",
        "family": "solver-imitation",
        "desc": "Capacity axis push: the same subset-solver target, but width 64 with an extra conv layer. Highest-parameter imitator, so it needs fewer epochs than M2 to converge; the reference to beat in CONCURRENT.",
        "rows": {
          "Family": "solver-imitation",
          "Method": "Behaviour cloning (subset solver, high capacity)",
          "Architecture": "width 64 · 5 layers · 87,777 params",
          "Training": "3,000 games · 8 epochs · lr 0.0015 · target subset-solver",
          "File size": "344.7 KB",
          "Eval": "win 61.4% · mine-hit 38.6% · stuck 0.0% · avg safe 46.9"
        },
        "current": false
      },
      {
        "id": "m4",
        "label": "M4 · Long-trained small imitation",
        "family": "solver-imitation",
        "desc": "Training-amount axis: identical width-32 architecture and basic-solver target as M1, but more demonstration games and a longer schedule. Isolates how far more data/optimisation steps help a small net on a weak target.",
        "rows": {
          "Family": "solver-imitation",
          "Method": "Behaviour cloning (basic solver, long schedule)",
