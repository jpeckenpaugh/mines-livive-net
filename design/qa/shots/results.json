      {
        "id": "m0",
        "label": "M0 · Uniform baseline",
        "family": "baseline",
        "desc": "Zero-weight baseline: masked argmax collapses to the lowest-index legal cell, so it sweeps the grid blindly and detonates almost immediately. Defines the floor the trained variants must beat.",
        "rows": {
          "Family": "baseline",
          "Method": "Uniform (zero logits)",
          "Architecture": "width 32 · 4 layers · 16,193 params",
